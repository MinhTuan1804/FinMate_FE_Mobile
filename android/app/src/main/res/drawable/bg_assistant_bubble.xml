<?xml version="1.0" encoding="utf-8"?>
<!-- Bong bóng trợ lý nổi 56dp (AssistantOverlayService): nền tròn chuyển màu, viền sáng mảnh, icon sparkles trắng 26dp ở giữa. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="oval">
            <gradient
                android:angle="315"
                android:startColor="@color/assistant_bubble_start"
                android:endColor="@color/assistant_bubble_end"
                android:type="linear" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <stroke
                android:width="1.5dp"
                android:color="@color/assistant_bubble_ring" />
        </shape>
    </item>
    <item
        android:bottom="15dp"
        android:drawable="@drawable/ic_sparkles_on_ink"
        android:left="15dp"
        android:right="15dp"
        android:top="15dp" />
</layer-list>
