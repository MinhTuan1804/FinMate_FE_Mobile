<?xml version="1.0" encoding="utf-8"?>
<!-- Xem trước widget 4x4 trong bộ chọn widget (Android 12+). Số liệu là VÍ DỤ tĩnh. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_preview_bg"
    android:orientation="vertical"
    android:padding="14dp">
    <TextView
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:maxLines="1" android:text="FinMate • Tất cả tài khoản"
        android:textColor="@color/widget_text_secondary" android:textSize="11sp" />
    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="6dp" android:orientation="horizontal">
        <LinearLayout
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="SỐ DƯ KHẢ DỤNG"
                android:textColor="@color/widget_text_secondary" android:textSize="10sp" />
            <TextView
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:maxLines="1" android:text="34.955.000 đ" android:textStyle="bold"
                android:textColor="@color/widget_text_primary" android:textSize="19sp" />
        </LinearLayout>
        <LinearLayout
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:maxLines="1" android:text="DỰ BÁO CUỐI THÁNG"
                android:textColor="@color/widget_text_secondary" android:textSize="10sp" />
            <TextView
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:maxLines="1" android:text="15.420.000 đ" android:textStyle="bold"
                android:textColor="@color/widget_text_primary" android:textSize="15sp" />
        </LinearLayout>
    </LinearLayout>
    <TextView
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:maxLines="1"
        android:text="Đã chi: 14.250.000 đ / Ngân sách: 15.000.000 đ"
        android:textColor="@color/widget_text_secondary" android:textSize="12sp" />
    <LinearLayout
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="10dp" android:orientation="horizontal">
        <TextView
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:background="@drawable/widget_preview_chip"
            android:gravity="center" android:padding="10dp" android:text="Chat"
            android:textColor="@color/widget_text_primary" android:textSize="13sp" />
        <TextView
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_marginStart="8dp" android:layout_weight="1"
            android:background="@drawable/widget_preview_chip_dark"
            android:gravity="center" android:padding="10dp" android:text="Quét QR"
            android:textColor="@color/widget_on_primary" android:textSize="13sp" />
    </LinearLayout>
    <TextView
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:text="Đã ghi 3 giao dịch hôm nay"
        android:textColor="@color/widget_text_secondary" android:textSize="12sp" />
    <TextView
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:text="Ví dụ"
        android:textColor="@color/widget_safe" android:textSize="10sp" />
</LinearLayout>
