<?xml version="1.0" encoding="utf-8"?>
<!-- Xem trước W2 trong bộ chọn widget (Android 12+). Số liệu là VÍ DỤ tĩnh. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_preview_bg"
    android:orientation="vertical"
    android:padding="14dp">
    <TextView
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:maxLines="1" android:text="FinMate • Tất cả tài khoản"
        android:textColor="@color/widget_text_secondary" android:textSize="11sp" />
    <TextView
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="6dp" android:text="SỐ DƯ KHẢ DỤNG"
        android:textColor="@color/widget_text_secondary" android:textSize="10sp" />
    <TextView
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:maxLines="1" android:text="34.955.000 đ" android:textStyle="bold"
        android:textColor="@color/widget_text_primary" android:textSize="22sp" />
    <TextView
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:maxLines="1" android:text="Đã chi tháng này: 45.000 đ"
        android:textColor="@color/widget_text_secondary" android:textSize="10sp" />
    <TextView
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:maxLines="1" android:text="Chi an toàn: 120.000 đ/ngày"
        android:textColor="@color/widget_text_secondary" android:textSize="10sp" />
    <LinearLayout
        android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_marginTop="6dp" android:layout_weight="1"
        android:gravity="center_vertical" android:orientation="horizontal">
        <TextView
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:background="@drawable/widget_preview_chip"
            android:gravity="center" android:padding="8dp" android:text="Chat"
            android:textColor="@color/widget_text_primary" android:textSize="12sp" />
        <TextView
            android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_marginStart="8dp" android:layout_weight="1"
            android:background="@drawable/widget_preview_chip_dark"
            android:gravity="center" android:padding="8dp" android:text="Quét QR"
            android:textColor="@color/widget_on_primary" android:textSize="12sp" />
    </LinearLayout>
    <TextView
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="Ví dụ" android:textColor="@color/widget_safe" android:textSize="10sp" />
</LinearLayout>
