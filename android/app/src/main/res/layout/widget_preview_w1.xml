<?xml version="1.0" encoding="utf-8"?>
<!-- Xem trước W1 "Hôm nay" (2×1) trong bộ chọn widget (Android 12+). Số liệu là VÍ DỤ tĩnh. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_preview_bg"
    android:gravity="center_vertical"
    android:orientation="vertical"
    android:paddingHorizontal="12dp"
    android:paddingVertical="8dp">
    <TextView
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:maxLines="1" android:text="Hôm nay · đã dùng 40%"
        android:textColor="@color/widget_text_secondary" android:textSize="10sp" />
    <TextView
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:maxLines="1"
        android:text="120.000 đ" android:textStyle="bold"
        android:textColor="@color/widget_text_primary" android:textSize="24sp" />
</LinearLayout>
