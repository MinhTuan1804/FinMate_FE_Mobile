<?xml version="1.0" encoding="utf-8"?>
<!-- Luồng 9 — bản RemoteViews cổ điển, KHÔNG qua Glance (không có Session/SessionWorker), đẩy
     thẳng qua AppWidgetManager.updateAppWidget() ngay sau khi *Sync.refresh() xong — thử nghiệm
     thêm 1 bước "chớp" dữ liệu mới ngay lập tức trước khi Glance vẽ lại bản đẹp (vòng tròn, màu
     trạng thái...) ở lần cập nhật kế tiếp. Nếu không cải thiện độ trễ hoặc gây giật/không nhất
     quán, bỏ hẳn bước này (giữ nguyên Glance updateAll() như trước) — xem WidgetQuickFlash.kt. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_vertical"
    android:background="#F8FAFC"
    android:padding="14dp">

    <TextView
        android:id="@+id/quick_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="#64748B"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/quick_amount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="#0F172A"
        android:textSize="20sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/quick_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:textColor="#64748B"
        android:textSize="11sp" />

</LinearLayout>
